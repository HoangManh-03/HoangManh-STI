<launch>
      <!-- vung lidar  -->
      <arg name="node_namespace" default="SafetyZone_cpp" />
      <rosparam command="load" 
                file="$(find safety_zone_cplus)/config/zone_param.yaml" 
                ns="$(arg node_namespace)"   />
      <node pkg="safety_zone_cplus" 
            name="$(arg node_namespace)" 
            type="$(arg node_namespace)" 
            output="screen"/>
            
</launch>